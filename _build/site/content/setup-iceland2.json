er == 'temp':\n        new_tracer[:, i, :] = temp[:, np.newaxis]  # vary with time\n    elif tracer == 'salt':\n        new_tracer[:, i, :] = 1\n    elif tracer == 'PO4':\n        new_tracer[:, i, :] = 0.4\n    elif tracer == 'NO3':\n        new_tracer[:, i, :] = 6\n    elif tracer == 'SiO3':\n        new_tracer[:, i, :] = 3\n    elif tracer == 'NH4':\n        new_tracer[:, i, :] = 0.4\n    elif tracer == 'Fe':\n        new_tracer[:, i, :] = 0.000197\n    elif tracer == 'Lig':\n        new_tracer[:, i, :] = 0.000465    \n    elif tracer == 'O2':\n        new_tracer[:, i, :] = 360    \n    elif tracer == 'DIC':\n        new_tracer[:, i, :] = 313    \n    elif tracer == 'DIC_ALT_CO2':\n        new_tracer[:, i, :] = 313  \n    elif tracer == 'ALK':\n        new_tracer[:, i, :] = 282 \n    elif tracer == 'ALK_ALT_CO2':\n        new_tracer[:, i, :] = 282 \n    else:\n        new_tracer[:, i, :] = 0.0\nriv['river_tracer'] = (riv['river_tracer'].dims, new_tracer)","key":"pRjmrxJDjx"},{"type":"outputs","id":"X6Nx-kz8ws9rBSw2CTvaB","children":[],"key":"THokgOJwml"}],"key":"Wj88GNVOGK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"i2RCXG0bh1"},{"type":"outputs","id":"5Ke32z8QYwOkF-SkExJrY","children":[],"key":"VYM39fDJaI"}],"key":"xhVF5qbVtn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.plot(temp)","key":"ZfIRx9LmeV"},{"type":"outputs","id":"gzRcf9uSY2iIbyL22C1Ma","children":[],"key":"AA6MnLwSED"}],"key":"X7gVpHlvgJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"riv.to_netcdf(project+model_name+\"_rivers_modified.nc\")","key":"WeTkOqcBQm"},{"type":"outputs","id":"SC4tQZRaqL4-xriYJiPqf","children":[],"key":"BBqW4ZXlVB"}],"key":"sVNsOcEyKg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"fsaj7ywLNK"},{"typ