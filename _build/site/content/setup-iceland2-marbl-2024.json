,"key":"w6p8y3QRdR"},{"type":"outputs","id":"9Ms3t6FPH0sQKYZqzf3Fv","children":[],"key":"rK6bMMJlG6"}],"key":"SFYCFI1H2Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"river_forcing.save(filepath=filepath)","key":"lBDbrDOfKP"},{"type":"outputs","id":"aTvec-me1Bc9jldVSfxJB","children":[],"key":"s6iP0IG4Vp"}],"key":"FRXHMJ2fYX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making some customizations to the river forcing (we have observed values of alk and DIC in the rivers and we also know the water is not going to be 17 degrees warm!). We add nutrients (observed values in fjord before spring bloom) and we add observed riverine values of Alk and DIC. These should be subject to change.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rRQkywP9BD"}],"key":"b6Cyz3aseG"}],"key":"QTChIFeNVe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import xarray as xr\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nriv=xr.open_dataset(filepath)\nriv.load()","key":"VKC3rcEoEG"},{"type":"outputs","id":"Z2_D7a9kyILKRFDg6vM8M","children":[],"key":"rpgnuqj4ek"}],"key":"srxYHLqI6F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create new array\nnew_tracer = np.zeros_like(riv['river_tracer'].values)\n\n# Temperature varies sinusoidally with time\ntemp = 10 * np.sin(np.linspace(0, np.pi, riv.dims['river_time']))  # 12-month cycle\n\n# Loop through tracers\nfor i, tracer in enumerate(riv['tracer_name'].values):\n    if tracer == 'temp':\n        new_tracer[:, i, :] = temp[:, np.newaxis]  # vary with time\n    elif tracer == 'salt':\n        new_tracer[:, i, :] = 1\n    elif tracer == 'PO4':\n        new_tracer[:, i, :] = 0.4\n    elif tracer == 'NO3':\n        new_tracer[:, i, :] = 6\n    elif tracer == 'SiO3':\n        new_tracer[:, i, :] = 3\n    elif tracer == 'NH4':\n        new_tracer[:, i, :] = 0.4\n    elif tracer == 'Fe':\n        new_tracer[:, i, :] = 0.000197\n    elif tracer == 'Lig':\n        new_tracer[:, i, :] = 0.000465    \n    elif tracer == 'O2':\n        new_tracer[:, i, :] = 360    \n    elif tracer == 'DIC':\n        new_tracer[:, i, :] = 313    \n    elif tracer == 'DIC_ALT_CO2':\n        new_tracer[:, i, :] = 313  \n    elif tracer == 'ALK':\n        new_tracer[:, i, :] = 282 \n    elif tracer == 'ALK_ALT_CO2':\n        new_tracer[:, i, :] = 282 \n    else:\n        new_tracer[:, i, :] = 0.0\nriv['river_tracer'] = (riv['river_tracer'].dims, new_tracer)","key":"kXRtd8dw2j"},{"type":"outputs","id":"l1psSmwGOs5DIy8w6T5ko","children":[],"key":"azlxkxmwun"}],"key":"nP4h94vLCu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"AGASSKOhz4"},{"type":"outputs","id":"j6F8KBxta20GnIX5qr9-j","children":[],"key":"WbfSA1sNUx"}],"key":"Ysc8iejIeZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.plot(temp)","key":"WbbSg3rrEy"},{"type":"outputs","id":"uvMso3J0oezicgKE3Awz-","children":[],"key":"W24CP9yEqF"}],"key":"uDdIprKdD9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"riv.to_netcdf(project+model_name+\"_rivers_modified.nc\")","key":"jTAE0e8FVi"},{"type":"outputs","id":"tv08E4aX-Y54PIfZ_08D1","children":[],"key":"bMkbV7RnDB"}],"key":"mDHoPO6ohS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"hwBMJ1ziHe"},{"type":"outputs","id":"QSBNC5lZVMWwALSD8zO3Z","children":[],"key":"TYOLKhnrpD"}],"key":"maJj2988r0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import xarray as xr\n\n# Open your modified file\nriver = xr.open_dataset(project+model_name+\"_rivers_modified.nc\")\nriver.load()\n# Show what tracers exist\nriver['river_tracer'].isel(ntracers=10).isel(nriver=6).plot()\n\n","key":"SK7JjUTXo3"},{"type":"outputs","id":"1oS4RGDjon9q3OsZHi3Dl","children":[],"key":"iSNz4tV5DK"}],"key":"NDrWoRVAsA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, we make another river forcing file with half as much volume","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WglQci0f7b"}],"key":"nEeSMJc5Wp"}],"key":"qIPB6ElHez"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"riv['river_volume'][:] = riv['river_volume'].isel(river_time=7)*0.6","key":"g0CVMi6Gll"},{"type":"outputs","id":"-kPhFpI5ApUwzpYoR0NSs","children":[],"key":"ybOxEsTRI6"}],"key":"xTyKXJIqod"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"winter_months = [1, 2, 3, 4, 11, 12]\n\n# Create a boolean mask for winter times\nwinter_mask = riv['abs_time'].dt.month.isin(winter_months)\n\n# Set river_volume to zero where the mask is True\nriv['river_volume'] = riv['river_volume'].where(~winter_mask, 0.0)","key":"vcyZ3CbjpS"},{"type":"outputs","id":"PVmMmzKgxGHkaSIYKi0H_","children":[],"key":"urx23tTmor"}],"key":"JmwimsegAR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"riv","key":"KHa5D74Mqe"},{"type":"outputs","id":"7yTGt2dyjMmQR7Muvcku9","children":[],"key":"cG1vGPozW0"}],"key":"TGOeisazfL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"riv.to_netcdf(project+model_name+\"_rivers_modified_new40off.nc\")","key":"YplcmY2VqZ"},{"type":"outputs","id":"Dq7DYNkJq